ENVIRONMENT=development
# Set DATABASE_URL to a local/hosted PostgreSQL database to use PostgreSQL locally.
# If omitted in development, the API creates a SQLite database automatically.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shelfscan
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_TTL_MINUTES=60
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
ADMIN_EMAILS=
ACTIVE_USER_WINDOW_MINUTES=30
ACTIVITY_UPDATE_SECONDS=300
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GOOGLE_BOOKS_API_KEY=
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
PORT=8000
